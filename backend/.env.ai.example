# Keep the API key on the backend only. Leave blank to keep live generation disabled.
OPENAI_API_KEY=

# Current configurable OpenAI image and moderation settings.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Private local storage. Do not point this at a public static directory.
AI_STORAGE_ROOT=.private-ai-storage
AI_UPLOAD_MAX_MB=8

# Provider timeout and AI-only abuse controls.
AI_GENERATION_TIMEOUT_MS=120000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=6

# Deterministic preview renderer version for future migration support.
AI_MOCKUP_RENDERER=sharp-v1

AUTH_SESSION_DAYS=7
AUTH_BCRYPT_ROUNDS=12
# Leave empty unless the frontend and API intentionally share a parent cookie domain.
AUTH_COOKIE_DOMAIN=
# Match the number of trusted reverse proxies in front of Express in production.
TRUST_PROXY=1

# Comma-separated browser origins allowed to send authenticated cross-origin
# requests in production. Development and Compose localhost origins are built in.
CORS_ORIGINS=https://your-store.example

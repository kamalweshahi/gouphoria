# Safe default: validates paid orders and marks them ready without calling the
# Printify order-creation API.
PRINTIFY_FULFILLMENT_MODE=disabled

# draft: creates a Printify order but does not call send-to-production.
# Confirm the Printify shop uses manual order approval before enabling this.
# production: creates the order and explicitly sends it to production.

# Checkout requests current options from Printify and saves the customer's
# selection. Quotes expire and must be refreshed after address/item changes.
PRINTIFY_SHIPPING_QUOTE_MINUTES=15

# Optional webhook setup. The base URL must be public HTTPS and the secret must
# contain at least 20 random characters. An admin can then call the protected
# Printify webhook synchronization endpoint.
PRINTIFY_WEBHOOK_BASE_URL=https://store.example.com
PRINTIFY_WEBHOOK_SECRET=replace-with-at-least-20-random-characters

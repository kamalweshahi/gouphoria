{
  "name": "printify-store-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc",
    "db:sync": "ts-node-dev --transpile-only --exit-child src/database/sync.ts",
    "catalog:sync": "node dist/database/sync-catalog.js",
    "test:auth": "node --test --test-concurrency=1 tests/auth.integration.test.js",
    "test:catalog": "node --test --test-concurrency=1 tests/catalog.unit.test.js tests/catalog.integration.test.js",
    "test:commerce": "node --test --test-concurrency=1 tests/commerce.integration.test.js",
    "test:fulfillment": "node --test --test-concurrency=1 tests/fulfillment.integration.test.js",
    "test:ai": "node --test --test-concurrency=1 tests/ai.integration.test.js",
    "test:ai-commerce": "node --test --test-concurrency=1 tests/ai-commerce.integration.test.js",
    "test:credits": "node --test --test-concurrency=1 tests/credits.integration.test.js",
    "test:release": "node --test --test-concurrency=1 tests/release.integration.test.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "docker": "NODE_ENV=docker node dist/app.js",
    "compose": "NODE_ENV=compose node dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "config": "^4.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "joi": "^18.2.1",
    "multer": "^2.2.0",
    "mysql2": "^3.22.4",
    "openai": "^6.48.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}

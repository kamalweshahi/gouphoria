# Database is opt-in for the standalone backend so the existing storefront can
# still run without MySQL. Docker Compose enables it automatically.
DB_ENABLED=false
DB_REQUIRED=false
DB_SYNC=false
DB_MIGRATE=true
DB_LOGGING=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=case_store
DB_USER=case_store
DB_PASSWORD=change-me

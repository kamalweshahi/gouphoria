# Core integrations (backend only; placeholders, never commit real credentials)
PRINTIFY_API_KEY=replace-with-printify-api-token
PRINTIFY_SHOP_ID=replace-with-printify-shop-id
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-sandbox-client-secret
OPENAI_API_KEY=

# Database
DB_ENABLED=false
DB_REQUIRED=false
DB_SYNC=false
DB_MIGRATE=true
DB_LOGGING=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=case_store
DB_USER=case_store
DB_PASSWORD=replace-with-a-strong-password
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_CONNECT_TIMEOUT_MS=10000

# Authentication and browser access
AUTH_SESSION_DAYS=7
AUTH_BCRYPT_ROUNDS=12
# Optional shared parent domain for cross-subdomain deployments. Leave empty locally.
AUTH_COOKIE_DOMAIN=
# Number of trusted reverse proxies (or another narrowly scoped Express trust-proxy value).
# Leave empty unless production is actually behind a trusted proxy.
TRUST_PROXY=
CORS_ORIGINS=http://localhost:5173,http://localhost:6124
REQUEST_JSON_LIMIT=100kb

# Printify fulfillment safety
PRINTIFY_FULFILLMENT_MODE=disabled
PRINTIFY_AI_PRINT_ON_SIDE=
PRINTIFY_SHIPPING_QUOTE_MINUTES=15
PRINTIFY_WEBHOOK_BASE_URL=https://store.example.com
PRINTIFY_WEBHOOK_SECRET=replace-with-at-least-20-random-characters

# AI generation, moderation, uploads, and mockups
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
AI_GENERATION_TIMEOUT_MS=120000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=6
AI_STORAGE_ROOT=.private-ai-storage
AI_UPLOAD_MAX_MB=8
AI_UPLOAD_MIN_DIMENSION=64
AI_UPLOAD_MAX_DIMENSION=12000
AI_UPLOAD_MAX_PIXELS=40000000
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=12
AI_MOCKUP_RENDERER=sharp-v1
MOCKUP_BACKFILL_ENABLED=true

# Credit purchase abuse controls and optional delivered-order reward
CREDIT_PURCHASE_RATE_LIMIT_WINDOW_MS=60000
CREDIT_PURCHASE_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX=30
PAYMENT_RATE_LIMIT_WINDOW_MS=60000
PAYMENT_RATE_LIMIT_MAX=20
ADMIN_ACTION_RATE_LIMIT_WINDOW_MS=60000
ADMIN_ACTION_RATE_LIMIT_MAX=30
PHONE_CASE_PURCHASE_REWARD_CREDITS=0
